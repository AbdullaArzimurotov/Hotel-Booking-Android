# Переменные для ручного запуска backend. Файл .env автоматически не читается сервером.
# scripts/dev.py server создаёт приватные пароли и передаёт настройки сам.
HOST=127.0.0.1
PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:55432/hotel_coursework
DB_USER=hotel_app
DB_PASSWORD=replace-with-a-private-local-password
